{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/portfolio.ts": {
      "includeFiles": "dist-ssr/index.html"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/portfolio"
    },
    {
      "src": "^/admin/myself/?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
